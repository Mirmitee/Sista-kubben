; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sista kubben"
config/description="Läskig roguelike-kubb i PS1-stil. Kastprototyp."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Lang="*res://scripts/lang.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=288
window/size/window_width_override=1152
window/size/window_height_override=864
window/stretch/mode="viewport"

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=16
3d/default_gravity=9.81

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
